{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wheelie-neat-supply-co",
  "main": "worker/index.js",
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 12 * * *"] },
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wheelie-neat-catalog",
      "database_id": "d383fb00-cd87-471f-a285-fbebdad79a95"
    }
  ]
}
